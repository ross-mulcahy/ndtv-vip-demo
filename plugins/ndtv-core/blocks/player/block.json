{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "ndtv/player",
	"version": "0.1.0",
	"title": "NDTV Player",
	"category": "media",
	"icon": "video-alt3",
	"description": "Plays a video from the Videos library, or a raw player ID from NDTV's player backend. Inside a Query Loop it plays the current video.",
	"keywords": [ "video", "player", "live", "ndtv" ],
	"textdomain": "ndtv-core",
	"usesContext": [ "postId", "postType" ],
	"attributes": {
		"videoId": { "type": "integer", "default": 0 },
		"playerId": { "type": "string", "default": "" },
		"showTitle": { "type": "boolean", "default": true },
		"autoplay": { "type": "boolean", "default": false }
	},
	"supports": {
		"html": false,
		"align": [ "wide", "full" ],
		"spacing": { "margin": true }
	},
	"editorScript": "ndtv-core-editor",
	"style": "file:./style.css",
	"render": "file:./render.php"
}
