{
	"$schema": "https://schemas.wp.org/trunk/theme.json",
	"version": 3,
	"settings": {
		"appearanceTools": true,
		"useRootPaddingAwareAlignments": true,
		"layout": { "contentSize": "760px", "wideSize": "1300px" },
		"color": {
			"defaultPalette": false,
			"defaultGradients": false,
			"palette": [
				{ "slug": "red", "color": "#E21B22", "name": "NDTV Red" },
				{ "slug": "ink", "color": "#1D1D1D", "name": "Ink" },
				{ "slug": "black", "color": "#111111", "name": "Black" },
				{ "slug": "text", "color": "#454A4F", "name": "Text" },
				{ "slug": "grey", "color": "#9C9C9C", "name": "Grey" },
				{ "slug": "panel", "color": "#FAFAFA", "name": "Panel" },
				{ "slug": "rule", "color": "#EEEEEE", "name": "Rule" },
				{ "slug": "white", "color": "#FFFFFF", "name": "White" },
				{ "slug": "night", "color": "#1A1A1A", "name": "Night (video UI)" },
				{ "slug": "sponsored", "color": "#F5B800", "name": "Sponsored" }
			]
		},
		"typography": {
			"defaultFontSizes": false,
			"fluid": true,
			"fontFamilies": [
				{
					"slug": "inter",
					"name": "Inter",
					"fontFamily": "Inter, system-ui, -apple-system, \"Segoe UI\", sans-serif",
					"fontFace": [
						{ "fontFamily": "Inter", "fontWeight": "400 800", "fontStyle": "normal", "fontDisplay": "swap", "src": [ "file:./assets/fonts/inter-latin-var.woff2" ] }
					]
				},
				{
					"slug": "noto-serif",
					"name": "Noto Serif",
					"fontFamily": "\"Noto Serif\", Georgia, serif",
					"fontFace": [
						{ "fontFamily": "Noto Serif", "fontWeight": "100 900", "fontStyle": "normal", "fontDisplay": "swap", "src": [ "file:./assets/fonts/noto-serif-latin-var.woff2" ] }
					]
				}
			],
			"fontSizes": [
				{ "slug": "x-small", "size": "12px", "name": "Extra small", "fluid": false },
				{ "slug": "small", "size": "14px", "name": "Small", "fluid": false },
				{ "slug": "medium", "size": "16px", "name": "Medium", "fluid": false },
				{ "slug": "large", "size": "18px", "name": "Large", "fluid": false },
				{ "slug": "x-large", "size": "24px", "name": "Extra large", "fluid": { "min": "20px", "max": "24px" } },
				{ "slug": "xx-large", "size": "30px", "name": "Lead", "fluid": { "min": "24px", "max": "30px" } },
				{ "slug": "huge", "size": "40px", "name": "Huge", "fluid": { "min": "28px", "max": "40px" } }
			]
		},
		"spacing": {
			"defaultSpacingSizes": false,
			"spacingSizes": [
				{ "slug": "10", "size": "4px", "name": "1" },
				{ "slug": "20", "size": "8px", "name": "2" },
				{ "slug": "30", "size": "12px", "name": "3" },
				{ "slug": "40", "size": "16px", "name": "4" },
				{ "slug": "50", "size": "24px", "name": "5" },
				{ "slug": "60", "size": "32px", "name": "6" },
				{ "slug": "70", "size": "48px", "name": "7" }
			]
		}
	},
	"styles": {
		"color": { "background": "var:preset|color|white", "text": "var:preset|color|text" },
		"typography": { "fontFamily": "var:preset|font-family|inter", "fontSize": "var:preset|font-size|medium", "lineHeight": "1.6" },
		"spacing": {
			"blockGap": "var:preset|spacing|40",
			"padding": { "left": "var:preset|spacing|40", "right": "var:preset|spacing|40" }
		},
		"elements": {
			"heading": {
				"color": { "text": "var:preset|color|ink" },
				"typography": { "fontFamily": "var:preset|font-family|noto-serif", "fontWeight": "500", "lineHeight": "1.3" }
			},
			"h1": { "typography": { "fontSize": "var:preset|font-size|huge", "lineHeight": "1.2" } },
			"h2": { "typography": { "fontSize": "var:preset|font-size|xx-large" } },
			"h3": { "typography": { "fontSize": "var:preset|font-size|large" } },
			"h4": { "typography": { "fontSize": "var:preset|font-size|medium" } },
			"link": {
				"color": { "text": "var:preset|color|ink" },
				"typography": { "textDecoration": "none" },
				":hover": { "color": { "text": "var:preset|color|red" } }
			},
			"button": {
				"color": { "background": "var:preset|color|red", "text": "var:preset|color|white" },
				"border": { "radius": "4px" },
				"typography": { "fontSize": "var:preset|font-size|small", "fontWeight": "600" }
			}
		},
		"blocks": {
			"core/post-title": {
				"typography": { "fontFamily": "var:preset|font-family|noto-serif", "fontWeight": "500" },
				"elements": { "link": { "color": { "text": "var:preset|color|ink" } } }
			},
			"core/post-excerpt": { "color": { "text": "var:preset|color|text" }, "typography": { "fontSize": "var:preset|font-size|small" } },
			"core/post-date": { "color": { "text": "var:preset|color|grey" }, "typography": { "fontSize": "var:preset|font-size|x-small" } },
			"core/post-author-name": { "typography": { "fontSize": "var:preset|font-size|x-small", "fontWeight": "600" } },
			"core/post-terms": { "typography": { "fontSize": "var:preset|font-size|x-small", "fontWeight": "700", "textTransform": "uppercase", "letterSpacing": "0.05em" }, "elements": { "link": { "color": { "text": "var:preset|color|red" } } } },
			"core/post-featured-image": { "spacing": { "margin": { "bottom": "var:preset|spacing|30" } } },
			"core/separator": { "color": { "text": "var:preset|color|rule" } },
			"core/navigation": { "typography": { "fontSize": "15px", "fontWeight": "600" } },
			"core/post-content": { "typography": { "fontSize": "var:preset|font-size|large", "lineHeight": "1.75" }, "color": { "text": "var:preset|color|ink" } }
		}
	},
	"templateParts": [
		{ "name": "header", "title": "Header", "area": "header" },
		{ "name": "footer", "title": "Footer", "area": "footer" },
		{ "name": "sidebar", "title": "Right rail", "area": "uncategorized" },
		{ "name": "video-nav", "title": "Video left rail", "area": "uncategorized" }
	]
}
