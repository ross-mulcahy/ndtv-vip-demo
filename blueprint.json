{
	"$schema": "https://playground.wordpress.net/blueprint-schema.json",
	"meta": {
		"title": "NDTV on WordPress VIP (demo)",
		"author": "WordPress VIP",
		"description": "Shallow NDTV replica: block theme, video CPT, NDTV Player block and seeded placeholder content."
	},
	"landingPage": "/",
	"preferredVersions": { "php": "8.3", "wp": "latest" },
	"features": { "networking": true },
	"steps": [
		{ "step": "login" },
		{
			"step": "setSiteOptions",
			"options": {
				"blogname": "NDTV",
				"blogdescription": "Latest news from India and the world (WordPress VIP demo)",
				"timezone_string": "Asia/Kolkata",
				"date_format": "M d, Y",
				"time_format": "h:i a",
				"permalink_structure": "/%category%/%postname%/",
				"posts_per_page": 15
			}
		},
		{
			"step": "installTheme",
			"themeData": { "resource": "bundled", "path": "/ndtv.zip" },
			"options": { "activate": true },
			"ifAlreadyInstalled": "overwrite"
		},
		{
			"step": "installPlugin",
			"pluginData": { "resource": "bundled", "path": "/ndtv-core.zip" },
			"options": { "activate": true },
			"ifAlreadyInstalled": "overwrite"
		},
		{
			"step": "runPHP",
			"progress": { "caption": "Seeding NDTV demo content" },
			"code": "<?php require '/wordpress/wp-load.php'; $r = ndtv_core_seed( true ); echo wp_json_encode( $r );"
		}
	]
}
